.{
    .primary = .{ .hex = "#6382ee" },
    .secondary = .{ .hex = "#7763cc" },
    .success = .{ .hex = "#42b080" },
    .info = .{ .hex = "#42a5dc" },
    .warning = .{ .hex = "#eeb333" },
    .@"error" = .{ .hex = "#dc4d4d" },
    .on_primary = .{ .hex = "#ffffff" },
    .on_secondary = .{ .hex = "#ffffff" },
    .on_success = .{ .hex = "#ffffff" },
    .on_info = .{ .hex = "#ffffff" },
    .on_warning = .{ .hex = "#1e1e21" },
    .on_error = .{ .hex = "#ffffff" },
    .bg = .{ .hex = "#121214" },
    .elevated = .{ .hex = "#1e1e21" },
    .muted = .{ .hex = "#2a2a2f" },
    .accented = .{ .hex = "#ededf2" },
    .inverted = .{ .hex = "#121214" },
    .text = .{ .hex = "#eaeaed" },
    .highlighted = .{ .hex = "#ffffff" },
    .toned = .{ .hex = "#52525a" },
    .dimmed = .{ .hex = "#9a9aa3" },
    .radius = 6,
    .font_size = .{ 12, 16, 20, 24, 28 },
    .scrollbar_thickness = 8,
    .scrollbar_min_thumb = 24,
    .scrollbar_track_color = .{ .hex = "#2a2a2f80" },
    .scrollbar_thumb_color = .{ .hex = "#6f6f78" },
    .scrollbar_thumb_hover_color = .{ .hex = "#ededf2" },
    .scrollbar_corner_radius = 4,
}
