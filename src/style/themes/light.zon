.{
    .primary = .{ .hex = "#4d6be0" },
    .secondary = .{ .hex = "#6250b8" },
    .success = .{ .hex = "#2e9467" },
    .info = .{ .hex = "#2089be" },
    .warning = .{ .hex = "#d49a1a" },
    .@"error" = .{ .hex = "#c03030" },
    .on_primary = .{ .hex = "#ffffff" },
    .on_secondary = .{ .hex = "#ffffff" },
    .on_success = .{ .hex = "#ffffff" },
    .on_info = .{ .hex = "#ffffff" },
    .on_warning = .{ .hex = "#1e1e21" },
    .on_error = .{ .hex = "#ffffff" },
    .bg = .{ .hex = "#f5f5f7" },
    .muted = .{ .hex = "#eaeaed" },
    .elevated = .{ .hex = "#ffffff" },
    .accented = .{ .hex = "#1e1e21" },
    .inverted = .{ .hex = "#f5f5f7" },
    .text = .{ .hex = "#18181a" },
    .highlighted = .{ .hex = "#000000" },
    .toned = .{ .hex = "#b8b8c0" },
    .dimmed = .{ .hex = "#6f6f78" },
    .radius = 6,
    .font_size = .{ 12, 16, 20, 24, 28 },
    .scrollbar_thickness = 8,
    .scrollbar_min_thumb = 24,
    .scrollbar_track_color = .{ .hex = "#eaeaed80" },
    .scrollbar_thumb_color = .{ .hex = "#9a9aa3" },
    .scrollbar_thumb_hover_color = .{ .hex = "#1e1e21" },
    .scrollbar_corner_radius = 4,
}
